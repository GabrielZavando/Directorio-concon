# Configuración del servidor
NODE_ENV=development
PORT=3000

# CORS - URLs permitidas (separadas por comas)
CORS_ORIGINS=http://localhost:4200,https://directorio-concon.web.app

# Rate Limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# Firebase Configuration
# El backend carga las credenciales del Admin SDK desde firebase-admin.json en la
# raíz del repo (service account real). Si el archivo existe, Firebase se
# AUTO-HABILITA aunque FIREBASE_ENABLED no esté definido.
#
#   - FIREBASE_ENABLED=false          -> fuerza deshabilitado (aunque exista el archivo).
#   - FIREBASE_ADMIN_CREDENTIALS_PATH -> ruta al archivo si no está en la raíz
#                                       (p.ej. secreto montado en Docker/VPS).
#
# Fallback SOLO para Docker/CI sin archivo: variables FIREBASE_* individuales.
FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=directorioconcon
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR-PRIVATE-KEY-HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@directorio-concon.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_STORAGE_BUCKET=directorioconcon.firebasestorage.app
FIREBASE_DATABASE_URL=https://directorio-concon-default-rtdb.firebaseio.com
FIREBASE_ADMIN_CREDENTIALS_PATH=

# JWT Secret (para futuras extensiones)
JWT_SECRET=directorio-concon-super-secret-key-change-in-production

# Cache y Redis
CACHE_STORE=memory
REDIS_URL=redis://localhost:6379
REDIS_TTL=300

# Configuración de archivos
MAX_FILE_SIZE=5242880

# Catalog cross-validation (categorias/barrios) — validates categoriaId/barrioId on places & eventos
# Desactivado por defecto; activar tras ejecutar `npm run seed` en el entorno destino
CATALOG_VALIDATION_ENABLED=false

# URLs de aplicación
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=info
ENABLE_LOGGING=true

# Paginación por defecto
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100