# OpenSpec artifacts
# Se versiona un registro de:
#   - specs principales sincronizadas (openspec/specs/)
#   - cambios ya archivados (openspec/changes/archive/)
# Los cambios activos en desarrollo (openspec/changes/<nombre>/) siguen ignorados.
openspec/*
!openspec/specs/
!openspec/specs/**
!openspec/changes/
openspec/changes/*
!openspec/changes/archive/
!openspec/changes/archive/**

# Node
node_modules/
.npm

# Entornos
.env
.env.local
.env.*.local

# Firebase service account (secret — NUNCA commitear)
firebase-admin.json
firebase-*.json

# OS
.DS_Store
Thumbs.db

# IDEs
.idea/
*.swp
*.swo
.vscode/

# Logs
*.log

# Build
dist/
backend/coverage/

# Source maps (Stitch exports or build artifacts)
*.map

# Specboot update backups
.specboot-backup-*
